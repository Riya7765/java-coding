import java.util.Vector;

class VectorDemo {
    public static void main(String[] args) {
        Vector<Integer> numbers = new Vector<>();

        numbers.add(10);
        numbers.add(20);
        numbers.add(30);
        numbers.add(40);
        numbers.add(50);

        numbers.remove(2);

        System.out.println("Updated Vector: " + numbers);
    }
}